LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
GOOGLE_SHEET_ID=
# The LINE Login channel the LIFF app is registered under — NOT the Messaging
# API channel ID. Used by LiffAuthGuard to verify LIFF ID tokens.
LINE_LOGIN_CHANNEL_ID=
# Shared-secret query param gating GET /dashboard/entries — the mom-facing
# dashboard has no LINE-login gate of its own, just a long random key baked
# into the Rich Menu button's URL. Not real auth, just an unguessable link.
DASHBOARD_ACCESS_KEY=
PORT=8080

# Local dev only — points at a downloaded service-account key (gitignored).
# In Cloud Run, do NOT set this; the service runs AS the service account instead
# (see README "GCP setup"), so Application Default Credentials picks it up with no key file.
GOOGLE_APPLICATION_CREDENTIALS=
